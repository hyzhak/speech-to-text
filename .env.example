# Audio Format Service Configuration
# 
# ⚠️  ALL VARIABLES ARE REQUIRED - The application will fail to start if any are missing
# 
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# For Docker deployment, these are set in docker-compose.yml
# For local development, set them in .env or export them

# ============================================================================
# Server Configuration (REQUIRED)
# ============================================================================

# Server bind address (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
AUDIO_FORMAT_HOST=0.0.0.0

# Server port (1-65535)
AUDIO_FORMAT_PORT=8001

# Enable auto-reload for development (true/false)
# ⚠️  Set to false in production!
AUDIO_FORMAT_RELOAD=false

# Logging level (debug, info, warning, error, critical)
AUDIO_FORMAT_LOG_LEVEL=info

# ============================================================================
# File Handling (REQUIRED)
# ============================================================================

# Directory for temporary file storage
AUDIO_FORMAT_TEMP_DIR=/app/temp

# Maximum file upload size in bytes (104857600 = 100MB)
AUDIO_FORMAT_MAX_FILE_SIZE=104857600

# ============================================================================
# Development Overrides
# ============================================================================
# Uncomment and modify for local development:
#
# AUDIO_FORMAT_RELOAD=true
# AUDIO_FORMAT_LOG_LEVEL=debug
# AUDIO_FORMAT_PORT=8002
# AUDIO_FORMAT_MAX_FILE_SIZE=209715200  # 200MB
